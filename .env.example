# Merge Agent Handler — https://ah.merge.dev/settings/api-keys
MERGE_AGENT_HANDLER_API_KEY=

# https://ah.merge.dev/tool-packs — the ID is in the URL of the Tool Pack
MERGE_TOOL_PACK_ID=

# Created by `bun run setup` (or copied from the dashboard)
MERGE_REGISTERED_USER_ID=

# Optional tuning for the dump
CONTEXT_WINDOW_DAYS=7
CONTEXT_PAGE_SIZE=25
CONTEXT_MAX_CHARS_PER_TOOL=20000
CONTEXT_TIMEOUT_MS=45000
CONTEXT_CONCURRENCY=4

# US: https://ah-api.merge.dev  |  EU dashboard (ah-eu.merge.dev): https://ah-api-eu.merge.dev
MERGE_API_BASE=https://ah-api.merge.dev

# Merge Gateway (LLM proxy) — https://gateway.merge.dev
MERGE_GATEWAY_API_KEY=

# OpenRouter — image generation
OPENROUTER_API_KEY=

# iMessage, read locally from ~/Library/Messages/chat.db (macOS only).
# Requires Full Disk Access for the process running the dev server.
# Never works on Vercel; the file only exists on your machine.
IMESSAGE_ENABLED=false
